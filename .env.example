# PostgreSQL connection string (Sequelize)
# Local dev example (adjust to your setup):
DATABASE_URL=postgresql://postgres:password@localhost:5432/ironlog

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: Auth.js trust host (needed when deploying behind a proxy/domain)
AUTH_TRUST_HOST=true

# Master key (KEK) for encrypting files at rest (progress photos, phase 2).
# 32 bytes base64. Generate with: openssl rand -base64 32
FILE_ENCRYPTION_KEY=replace-with-a-long-random-string

# Directory outside the webroot where encrypted files are stored
STORAGE_PATH=/var/lib/ironlog/storage
